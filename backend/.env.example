# SentinelCore local development configuration
APP_DATA_MODE=live
SERVER_PORT=8081

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/sentinelcore
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_postgres_password

TELEMETRY_INTERVAL_SECONDS=5
CPU_ALERT_THRESHOLD=90
MEMORY_ALERT_THRESHOLD=90
DISK_ALERT_THRESHOLD=90
ASSET_OFFLINE_TIMEOUT_SECONDS=60
AUTO_CREATE_INCIDENTS=false

# Production bootstrap admin (set a strong password; or disable after creating an admin)
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
BOOTSTRAP_ADMIN_EMAIL=admin@your-domain.com

# If frontend is hosted on another domain (for example Vercel + Render), use None + Secure.
SESSION_COOKIE_SAME_SITE=none
SESSION_COOKIE_SECURE=true

# Optional integrations
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-sender@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM=your-sender@gmail.com
NVD_API_KEY=
